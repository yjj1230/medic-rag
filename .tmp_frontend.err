ull,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":4,"patchFlag":8,"dynamicProps":["msg"],"dynamicChildren":[],"appContext":null,"ctx":"[Circular]"},{"__v_isVNode":true,"__v_skip":true,"type":"[Circular]","props":{"key":3,"msg":"[Circular]"},"key":3,"ref":null,"scopeId":"data-v-64849fe3","slotScopeIds":null,"children":null,"component":{"uid":51,"vnode":"[Circular]","type":"[Circular]","parent":"[Circular]","appContext":"[Circular]","root":"[Circular]","next":null,"subTree":{"__v_isVNode":true,"__v_skip":true,"type":"div","props":{"class":"message-row assistant-row"},"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":[{"__v_isVNode":true,"__v_skip":true,"type":"div","props":{"class":"message-bubble assistant"},"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":[{"__v_isVNode":true,"__v_skip":true,"props":null,"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":"v-if","component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":8,"patchFlag":0,"dynamicProps":null,"dynamicChildren":[],"appContext":null,"ctx":"[Circular]"},{"__v_isVNode":true,"__v_skip":true,"type":"div","props":{"innerHTML":"<h2>为什么高血压常常没有症状</h2><br>根据现有证据，高血压通常没有明显的警告症状，单靠感觉不能判断血压是否正常 。世界卫生组织（WHO）的资料同样指出，多数高血压者没有明显症状，因此规范测量血压是发现高血压的关键 。<br><br>至于“为什么”没有症状背后的具体生理机制（例如身体如何逐渐适应压力升高等），现有证据只描述了“通常无症状”这一现象，并没有解释其机制，因此我无法基于这些证据可靠回答机制层面的原因 。如果想进一步了解，建议与医护人员讨论 。<br><br><h2>没有症状不等于没有风险</h2><br>持续的高血压会增加心脏病和卒中等健康风险 。WHO 资料指出，未治疗的高血压可能导致肾脏疾病、心脏疾病和卒中；长期压力会损害心脏和供给脑部的血管，也可能造成肾脏损害并进展到肾功能衰竭 。这正是不能靠感觉判断、而需要通过规范测量并与医护人员讨论结果的原因 。<br><br><h2>需要立即就医的情况</h2><br>虽然平时通常没有症状，但以下情况需要立即处理：如果血压读数高于 180/120 mmHg，应按相关页面说明重新测量并联系医护人员 ；如果同时出现突发剧烈头痛、呼吸困难、胸部/背部/腹部剧痛、麻木或无力、视力改变或言语障碍，应立即拨打当地急救电话 。类似地，血压显著升高并伴有剧烈头痛、视物模糊、胸痛、呼吸困难、言语不清或肢体无力时，应立即就医，这些表现可能提示高血压急症或脑血管事件，延误处理会造成不可逆损害 。<br><br><h2>平时可以做什么</h2><br>需要通过规范测量了解血压情况，并与医护人员讨论结果 。WHO 的成人高血压定义是血压达到或超过 140/90 mmHg，并且诊断需要在不同日期进行测量，一次读数不能单独完成诊断 。在管理方面，高血压管理通常包括生活方式调整（如控制钠摄入、规律活动、体重管理、限制饮酒、戒烟）和必要时的药物治疗；是否开始用药、如何调整以及何时复诊，取决于血压水平、心血管风险、其他疾病和医生的评估，不能自行停药、加倍用药或替换药物 。<br><br>以上内容属于一般健康教育，不用于个体化诊断，也不能替代医生的评估 。<br>","class":"message-text"},"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":null,"component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":1,"patchFlag":8,"dynamicProps":"[Circular]","dynamicChildren":null,"appContext":null,"ctx":"[Circular]"},{"__v_isVNode":true,"__v_skip":true,"props":null,"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":"\n        非医学回答标注（G4）。闲聊没有证据，必须**显式**告知用户这一点；\n        没有这个标注，用户会把一句模型自述的闲聊误当成\"有医学依据\"的回答。\n      ","component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":8,"patchFlag":0,"dynamicProps":null,"dynamicChildren":null,"appContext":null,"ctx":"[Circular]"},{"__v_isVNode":true,"__v_skip":true,"props":null,"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":"v-if","component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":8,"patchFlag":0,"dynamicProps":null,"dynamicChildren":[],"appContext":null,"ctx":"[Circular]"},{"__v_isVNode":true,"__v_skip":true,"props":{"key":3},"key":3,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":[{"__v_isVNode":true,"__v_skip":true,"props":null,"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":"\n        历史恢复的降级提示：引用条目的标题/来源未落库，无法还原引用徽章，\n        但\"有依据\"这一事实必须让用户看见（否则会被误读成无依据回答）。\n\n        ⚠️ G4：`!msg.casual` 这个条件**不可省略**。casual 消息的\n        citedEvidenceCount 恒为 0，因此本条在实际数据下不会触发；保留这个\n        守卫是为了让\"casual 绝不出现引用类元素\"成为**结构性保证**，而不是\n        \"恰好因为计数为 0 才没触发\"——后者一旦上游改口径就会静默破功。\n      ","component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":8,"patchFlag":0,"dynamicProps":null,"dynamicChildren":null,"appContext":null,"ctx":"[Circular]"},{"__v_isVNode":true,"__v_skip":true,"type":"div","props":{"class":"citations-degraded"},"key":null,"ref":null,"scopeId":"data-v-a8e5f966","slotScopeIds":null,"children":" 本回答引用 7 条证据（历史消息） ","component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":9,"patchFlag":1,"dynamicProps":null,"dynamicChildren":null,"appContext":null,"ctx":"[Circular]"}],"component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":{},"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":16,"patchFlag":2112,"dynamicProps":null,"dynamicChildren":["[Circular]"],"appContext":null,"ctx":"[Circular]"}],"component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":17,"patchFlag":2,"dynamicProps":null,"dynamicChildren":null,"appContext":null,"ctx":"[Circular]"}],"component":null,"suspense":null,"ssContent":null,"ssFallback":null,"dirs":null,"transition":null,"el":{},"anchor":null,"target":null,"targetStart":null,"targetAnchor":null,"staticCount":0,"shapeFlag":17,"patchFlag":2,"dynamicProps":null,"dynamicChildren":["[Circular]","[Circular]","[Circular]","[Circular]","[Circular]"],"appContext":null,"ctx":"[Circular]"},"effect":{"deps":{"sub":"[C