2,"globalVersion":45,"effect":"[Circular]","__v_isReadonly":true,"isSSR":false},"version":1,"subs":"[Circular]","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":1,"prevDep":"[Circular]","nextDep":{"sub":"[Circular]","dep":{"version":0,"subs":"[Circular]","map":{},"key":"$slots","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":0,"prevDep":"[Circular]","nextDep":{"sub":"[Circular]","dep":{"version":0,"subs":"[Circular]","map":{},"key":"isLoggedIn","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":0,"prevDep":"[Circular]","nextDep":{"sub":"[Circular]","dep":{"version":0,"subs":"[Circular]","map":"[Circular]","key":"$id","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":0,"prevDep":"[Circular]","nextDep":"[Circular]"}}}}},"depsTail":"[Circular]","flags":37},"dep":"[Circular]","version":0,"prevDep":"[Circular]"},"sc":1,"__v_skip":true,"subsHead":"[Circular]"},"__v_isRef":true,"__v_isShallow":false,"_rawValue":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UBftOuUesQ8NODHjx9kjVahQddLXlp1owjlBBwOYQeU","_value":"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UBftOuUesQ8NODHjx9kjVahQddLXlp1owjlBBwOYQeU"},"loading":{"dep":{"version":0,"sc":0,"__v_skip":true},"__v_isRef":true,"__v_isShallow":false,"_rawValue":false,"_value":false},"error":{"dep":{"version":0,"sc":0,"__v_skip":true},"__v_isRef":true,"__v_isShallow":false,"_rawValue":"","_value":""}},"chat":{"messages":{"dep":{"version":1,"activeLink":{"sub":{"deps":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","map":"[Circular]","key":"messages","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"nextDep":"[Circular]"},"depsTail":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"prevDep":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","map":"[Circular]","key":"loading","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"prevDep":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"prevDep":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"prevDep":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","map":{},"sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"prevDep":{"sub":"[Circular]","dep":{"version":0,"activeLink":"[Circular]","subs":"[Circular]","map":"[Circular]","key":"length","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":-1,"prevDep":"[Circular]","nextDep":"[Circular]"},"nextDep":"[Circular]"},"nextDep":"[Circular]"},"nextDep":"[Circular]"},"nextDep":"[Circular]"}},"flags":39},"dep":"[Circular]","version":-1,"prevDep":"[Circular]","nextDep":"[Circular]"},"subs":"[Circular]","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"__v_isRef":true,"__v_isShallow":false,"_rawValue":[{"role":"user","content":"哈哈哈"},{"role":"assistant","content":"哈哈，看你心情不错呀～有什么开心的事吗？或者想聊点什么轻松的话题，我随时奉陪😄","traceId":null,"citedEvidenceCount":0,"casual":true},{"role":"user","content":"高血压为什么没有症状"},{"role":"assistant","content":"## 为什么高血压常常没有症状\n\n根据现有证据，高血压通常没有明显的警告症状，单靠感觉不能判断血压是否正常 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。世界卫生组织（WHO）的资料同样指出，多数高血压者没有明显症状，因此规范测量血压是发现高血压的关键 [1f18737d-6471-4de4-a790-867fdf9034b8]。\n\n至于“为什么”没有症状背后的具体生理机制（例如身体如何逐渐适应压力升高等），现有证据只描述了“通常无症状”这一现象，并没有解释其机制，因此我无法基于这些证据可靠回答机制层面的原因 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。如果想进一步了解，建议与医护人员讨论 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。\n\n## 没有症状不等于没有风险\n\n持续的高血压会增加心脏病和卒中等健康风险 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。WHO 资料指出，未治疗的高血压可能导致肾脏疾病、心脏疾病和卒中；长期压力会损害心脏和供给脑部的血管，也可能造成肾脏损害并进展到肾功能衰竭 [1dba0b0c-0bcd-4f30-b1e2-938ae5a3e5f2]。这正是不能靠感觉判断、而需要通过规范测量并与医护人员讨论结果的原因 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。\n\n## 需要立即就医的情况\n\n虽然平时通常没有症状，但以下情况需要立即处理：如果血压读数高于 180/120 mmHg，应按相关页面说明重新测量并联系医护人员 [8c09dd65-8322-4ffd-b665-73d136b31b7a]；如果同时出现突发剧烈头痛、呼吸困难、胸部/背部/腹部剧痛、麻木或无力、视力改变或言语障碍，应立即拨打当地急救电话 [8c09dd65-8322-4ffd-b665-73d136b31b7a]。类似地，血压显著升高并伴有剧烈头痛、视物模糊、胸痛、呼吸困难、言语不清或肢体无力时，应立即就医，这些表现可能提示高血压急症或脑血管事件，延误处理会造成不可逆损害 [217f6ad9-8059-4a61-9b1c-5e6884393c21]。\n\n## 平时可以做什么\n\n需要通过规范测量了解血压情况，并与医护人员讨论结果 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。WHO 的成人高血压定义是血压达到或超过 140/90 mmHg，并且诊断需要在不同日期进行测量，一次读数不能单独完成诊断 [1f18737d-6471-4de4-a790-867fdf9034b8]。在管理方面，高血压管理通常包括生活方式调整（如控制钠摄入、规律活动、体重管理、限制饮酒、戒烟）和必要时的药物治疗；是否开始用药、如何调整以及何时复诊，取决于血压水平、心血管风险、其他疾病和医生的评估，不能自行停药、加倍用药或替换药物 [4d34b07f-7cae-47f6-9d9d-71b1663a4f5f]。\n\n以上内容属于一般健康教育，不用于个体化诊断，也不能替代医生的评估 [6d1ad19f-f0d7-48ff-a856-f66a0ce507ae]。","traceId":"9a9c7d25-f30a-42bf-a010-2169bd1de7ae","citedEvidenceCount":7}],"_value":[{"role":"user","content":"哈哈哈"},{"role":"assistant","content":"哈哈，看你心情不错呀～有什么开心的事吗？或者想聊点什么轻松的话题，我随时奉陪😄","traceId":null,"citedEvidenceCount":0,"casual":true},{"role":"user","content":"高血压为什么没有症状"},{"role":"assistant","content":"## 为什么高血压常常没有症状\n\n根据现有证据，高血压通常没有明显的警告症状，单靠感觉不能判断血压是否正常 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。世界卫生组织（WHO）的资料同样指出，多数高血压者没有明显症状，因此规范测量血压是发现高血压的关键 [1f18737d-6471-4de4-a790-867fdf9034b8]。\n\n至于“为什么”没有症状背后的具体生理机制（例如身体如何逐渐适应压力升高等），现有证据只描述了“通常无症状”这一现象，并没有解释其机制，因此我无法基于这些证据可靠回答机制层面的原因 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。如果想进一步了解，建议与医护人员讨论 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。\n\n## 没有症状不等于没有风险\n\n持续的高血压会增加心脏病和卒中等健康风险 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。WHO 资料指出，未治疗的高血压可能导致肾脏疾病、心脏疾病和卒中；长期压力会损害心脏和供给脑部的血管，也可能造成肾脏损害并进展到肾功能衰竭 [1dba0b0c-0bcd-4f30-b1e2-938ae5a3e5f2]。这正是不能靠感觉判断、而需要通过规范测量并与医护人员讨论结果的原因 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。\n\n## 需要立即就医的情况\n\n虽然平时通常没有症状，但以下情况需要立即处理：如果血压读数高于 180/120 mmHg，应按相关页面说明重新测量并联系医护人员 [8c09dd65-8322-4ffd-b665-73d136b31b7a]；如果同时出现突发剧烈头痛、呼吸困难、胸部/背部/腹部剧痛、麻木或无力、视力改变或言语障碍，应立即拨打当地急救电话 [8c09dd65-8322-4ffd-b665-73d136b31b7a]。类似地，血压显著升高并伴有剧烈头痛、视物模糊、胸痛、呼吸困难、言语不清或肢体无力时，应立即就医，这些表现可能提示高血压急症或脑血管事件，延误处理会造成不可逆损害 [217f6ad9-8059-4a61-9b1c-5e6884393c21]。\n\n## 平时可以做什么\n\n需要通过规范测量了解血压情况，并与医护人员讨论结果 [c215f4b2-8c97-47b4-9d68-fca55beb14a3]。WHO 的成人高血压定义是血压达到或超过 140/90 mmHg，并且诊断需要在不同日期进行测量，一次读数不能单独完成诊断 [1f18737d-6471-4de4-a790-867fdf9034b8]。在管理方面，高血压管理通常包括生活方式调整（如控制钠摄入、规律活动、体重管理、限制饮酒、戒烟）和必要时的药物治疗；是否开始用药、如何调整以及何时复诊，取决于血压水平、心血管风险、其他疾病和医生的评估，不能自行停药、加倍用药或替换药物 [4d34b07f-7cae-47f6-9d9d-71b1663a4f5f]。\n\n以上内容属于一般健康教育，不用于个体化诊断，也不能替代医生的评估 [6d1ad19f-f0d7-48ff-a856-f66a0ce507ae]。","traceId":"9a9c7d25-f30a-42bf-a010-2169bd1de7ae","citedEvidenceCount":7}]},"loading":{"dep":"[Circular]","__v_isRef":true,"__v_isShallow":false,"_rawValue":false,"_value":false},"error":{"dep":{"version":0,"sc":0,"__v_skip":true},"__v_isRef":true,"__v_isShallow":false,"_rawValue":"","_value":""},"sessionId":{"dep":"[Circular]","__v_isRef":true,"__v_isShallow":false,"_rawValue":"9515c863-91db-4996-ade0-98cf9e9bf412","_value":"9515c863-91db-4996-ade0-98cf9e9bf412"},"sessions":{"dep":{"version":0,"sc":0,"__v_skip":true},"__v_isRef":true,"__v_isShallow":false,"_rawValue":[],"_value":[]}},"documents":{"items":{"dep":{"version":1,"subs":{"sub":{"deps":{"sub":"[Circular]","dep":{"version":2,"subs":"[Circular]","map":{},"key":"$slots","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":2,"nextDep":{"sub":"[Circular]","dep":{"version":2,"subs":"[Circular]","map":{},"key":"$slots","sc":3,"__v_skip":true,"subsHead":{"sub":{"deps":{"sub":"[Circular]","dep":{"version":2,"subs":"[Circular]","map":{},"key":"$slots","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":2,"nextDep":{"sub":"[Circular]","dep":{"version":2,"subs":"[Circular]","map":{},"key":"$slots","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":2,"prevDep":"[Circular]","nextDep":{"sub":"[Circular]","dep":{"version":2,"subs":"[Circular]","map":{},"key":"$slots","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":2,"prevDep":"[Circular]","nextDep":{"sub":"[Circular]","dep":{"version":2,"subs":{"sub":{"deps":{"sub":"[Circular]","dep":{"version":2,"subs":"[Circular]","map":{},"key":"$slots","sc":1,"__v_skip":true,"subsHead":"[Circular]"},"version":2,