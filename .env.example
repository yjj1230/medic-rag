ENVIRONMENT=local
POSTGRES_PASSWORD=SET_LOCALLY
REDIS_PASSWORD=SET_LOCALLY
MINIO_ROOT_USER=SET_LOCALLY
MINIO_ROOT_PASSWORD=SET_LOCALLY
JWT_SECRET=SET_LOCALLY_TO_32_RANDOM_BYTES
# JSON mapping of enrollment codes to tenant UUIDs; keep real codes in a secret store.
REGISTRATION_TENANT_CODES={"local-demo":"11111111-1111-1111-1111-111111111111"}
DATABASE_URL=postgresql+psycopg://medical_rag:medical_rag@localhost:5432/medical_rag
OPENSEARCH_URL=http://localhost:9200
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=medical-rag
OBJECT_STORE_ACCESS_KEY=medical_rag
OBJECT_STORE_SECRET_KEY=SET_LOCALLY
OBJECT_STORE_REGION=us-east-1
REDIS_URL=redis://localhost:6379/0
# Use a fresh namespace when switching from the legacy SQLite/OpenSearch data.
RAG_PUBLIC_INDEX_NAME=medical-rag-public-pg-local
RAG_PRIVATE_INDEX_NAME=medical-rag-private-pg-local
RAG_TEXT_ANALYZER=cjk
RAG_SEARCH_ANALYZER=cjk
# 远程网关必须使用 HTTPS；本地开发可使用回环 sidecar。
MODEL_GATEWAY_URL=http://127.0.0.1:18097/v1
MODEL_PROVIDER_ID=lan-chat
MODEL_NAME=gpt-5.5
MODEL_WIRE_API=chat_completions
MODEL_GATEWAY_API_KEY=YOUR_GATEWAY_KEY
MODEL_DATA_REGION=SET_BY_DEPLOYMENT
MODEL_ZERO_RETENTION=true
MODEL_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_INDEX_VERSION=private-v1
RAG_TEXT_ANALYZER=cjk
RAG_SEARCH_ANALYZER=cjk
RAG_ALLOW_UNEMBEDDED=0
VIRUS_SCANNER_BACKEND=none
QUERY_REWRITE_ENABLED=true
QUERY_PIPELINE_HISTORY_SIZE=4
QUERY_LLM_REWRITE_ENABLED=false
INTENT_LLM_CLASSIFY_ENABLED=false

# ---- PaddleOCR-VL remote OCR backend (逐页 OCR / 图片识别) ----
# 留空 = 禁用远程 OCR（保持原生解析，默认）；配置后扫描 PDF 缺文本页与图片均走远程识别
# OCR_SERVICE_URL=http://192.168.254.35:18080
# OCR_USERNAME=SET_LOCALLY
# OCR_PASSWORD=SET_LOCALLY
# OCR_TIMEOUT_SECONDS=90
